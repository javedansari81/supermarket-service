# Database Configuration
DATABASE_URL=postgresql://warsi_user:your_password@localhost:5432/warsi_db
DB_SCHEMA=mart

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Customer login (online ordering)
CUSTOMER_ACCESS_TOKEN_EXPIRE_MINUTES=30
CUSTOMER_REFRESH_TOKEN_EXPIRE_DAYS=60
# OTP sender: empty disables customer login, "console" logs the code (development only)
OTP_PROVIDER=
OTP_EXPIRE_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_MOBILE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20

# Application Configuration
APP_NAME=Supermarket Management System
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Store subdomains (store1.mfmart.co.in only accepts its own store's users); empty disables
BASE_DOMAIN=

# Barcode Configuration
BARCODE_FORMAT=code128
BARCODE_DPI=300

# Invoice Configuration
INVOICE_PREFIX=INV

# Cloudflare R2 (supplier bill uploads)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=warsi-mart-bills
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
BILL_MAX_SIZE_MB=10
BILL_URL_EXPIRE_SECONDS=600

