# Customer shop API (copy to .env.local and adjust)
VITE_API_URL=http://localhost:8000/api/v1

# Store websites: each address opens its store (address=store subdomain label, comma separated)
# e.g. VITE_STORE_SITES=demo-shop.mfmart.co.in=demo-store,warsi-shop.mfmart.co.in=warsi-store
VITE_STORE_SITES=

# Store for any other address (e.g. localhost:3001); empty = "This address is not set up for a store"
VITE_DEFAULT_STORE=demo-store
