# Customer shop API (copy to .env.local and adjust)
VITE_API_URL=http://localhost:8000/api/v1

# Store websites: each address opens that store only (address=store subdomain label, comma separated).
# Any other address shows all stores with /<store>/... pages.
# e.g. VITE_STORE_SITES=demo-shop.mfmart.co.in=demo-store,warsi-shop.mfmart.co.in=warsi-store
VITE_STORE_SITES=

# Fix one store for the whole build (local testing); usually left empty
VITE_STORE=
